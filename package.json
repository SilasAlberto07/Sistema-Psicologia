{
  "name": "sistema-psicologia",
  "version": "1.4.7",
  "description": "",
  "main": "app/main.js",
  "scripts": {
    "start": "electron .",
    "dist": "dotenv -- electron-builder --publish always",
    "dist:mac": "electron-builder --mac",
    "release": "npm version patch && git push origin main --follow-tags && npm run dist",
    "postinstall": "electron-builder install-app-deps",
    "rebuild": "electron-rebuild -f -w better-sqlite3"
  },
  "build": {
    "appId": "com.claudiabethania.sistemapsicologia",
    "productName": "Sistema Psicologia",
    "win": {
      "target": "nsis",
      "icon": "build/PsiLogo.ico"
    },
    "mac": {
      "target": ["dmg", "zip"],
      "icon": "build/PsiLogo.icns",
      "category": "public.app-category.medical",
      "identity": null,
      "hardenedRuntime": false,
      "gatekeeperAssess": false
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    },
    "files": [
      "**/*",
      "!node_modules/electron-builder",
      "!node_modules/electron"
    ],
    "asarUnpack": [
      "node_modules/better-sqlite3/**/*"
    ],
    "publish": {
      "provider": "github",
      "owner": "SilasAlberto07",
      "repo": "Sistema-Psicologia",
      "releaseType": "release"
    }
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/SilasAlberto07/Sistema-Psicologia.git"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "commonjs",
  "bugs": {
    "url": "https://github.com/SilasAlberto07/Sistema-Psicologia/issues"
  },
  "homepage": "https://github.com/SilasAlberto07/Sistema-Psicologia#readme",
  "devDependencies": {
    "@electron/rebuild": "^4.2.0",
    "dotenv-cli": "^11.0.0",
    "electron": "^43.1.0",
    "electron-builder": "^26.15.3"
  },
  "dependencies": {
    "adm-zip": "^0.6.0",
    "archiver": "^7.0.1",
    "better-sqlite3": "^12.11.1",
    "dotenv": "^17.4.2",
    "electron-log": "^5.4.4",
    "electron-updater": "^6.8.9",
    "node-cron": "^4.6.0",
    "serve-handler": "^6.1.7",
    "sweetalert2": "^11.26.25"
  }
}
